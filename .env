# Root-level environment reference for BHUMI-X.
# Copy backend/.env.example to backend/.env and edit there; this file
# documents the same variables for quick reference at the project root.

DEMO_MODE=true
SQLITE_PATH=./bhumix_demo.db
DATABASE_URL=postgresql://bhumix:bhumix@localhost:5432/bhumix
DATA_DIR=../data
FRONTEND_ORIGIN=http://localhost:5173
TARGET_CRS=EPSG:4326
MATCH_MAX_DISTANCE_M=75
LOG_LEVEL=INFO