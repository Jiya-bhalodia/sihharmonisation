# BHUMI-X Backend Environment Configuration

# Demo mode: true = SQLite + local files, false = requires DATABASE_URL to a Postgres+PostGIS instance
DEMO_MODE=true

# SQLite path (used when DEMO_MODE=true)
SQLITE_PATH=./bhumix_demo.db

# Postgres connection (used when DEMO_MODE=false)
DATABASE_URL=postgresql://bhumix:bhumix@localhost:5432/bhumix

# Directory where uploaded/sample datasets live
DATA_DIR=../data

# CORS origin for frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# Default target CRS for harmonized output
TARGET_CRS=EPSG:4326

# Spatial matching max distance (meters) to consider two features candidate matches
MATCH_MAX_DISTANCE_M=75

# Log level
LOG_LEVEL=INFO