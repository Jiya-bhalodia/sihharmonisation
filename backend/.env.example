# BHUMI-X Backend Environment Configuration

# Demo mode: true = SQLite + local files, false = requires DATABASE_URL to a Postgres+PostGIS instance
DEMO_MODE=true

# Hosted SIH evaluation profile: keeps PostgreSQL and authentication, limits
# inputs to small vector data, runs only allowlisted harmonization synchronously,
# and never requires the Celery worker. Defaults off to preserve all deployments.
FREE_DEMO_MODE=false
FREE_DEMO_ALLOWED_JOB_TYPES=vector_harmonization
FREE_DEMO_MAX_UPLOAD_MB=2
FREE_DEMO_MAX_DATASETS=20
FREE_DEMO_MAX_FEATURES=1000
FREE_DEMO_MAX_GEOMETRY_COMPLEXITY=25000
FREE_DEMO_MAX_PROCESSING_SECONDS=20

# SQLite path (used when DEMO_MODE=true)
SQLITE_PATH=./bhumix_demo.db

# Postgres connection (used when DEMO_MODE=false)
DATABASE_URL=postgresql+psycopg://bhumix:change-this@localhost:5432/bhumix
# Use the schema where PostGIS is installed (e.g. extensions) for Supabase.
POSTGIS_SCHEMA=public
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

# Production authentication. Generate at least 32 random bytes for AUTH_SECRET_KEY.
AUTH_ENABLED=true
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
AUTH_TOKEN_TTL_MINUTES=720
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# S3-compatible object storage. Set this to the MinIO endpoint in Compose.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=bhumix-originals
OBJECT_STORAGE_ACCESS_KEY=replace-with-object-store-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-object-store-secret-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=bhumi-x
# Cloudflare R2 uses AWS_DEFAULT_REGION=auto; omit for local MinIO if desired.
AWS_DEFAULT_REGION=

# Redis-backed worker queue for large raster inspection jobs.
REDIS_URL=redis://redis:6379/0
ASYNC_RASTER_THRESHOLD_MB=32

# Free local OCR for scanned PDFs (Tesseract language packs installed in Docker).
OCR_LANGUAGES=eng+hin+mar
OCR_MAX_PAGES=20

# Optional local inference. These use cached open model weights only; no hosted API.
BUILDING_EXTRACTION_ENABLED=false
ENABLE_LOCAL_EMBEDDINGS=false
ENABLE_LOCAL_LLM_CLASSIFICATION=false
LOCAL_LLM_URL=http://127.0.0.1:11434/api/generate
LOCAL_LLM_MODEL=llama3.2:3b
BUILDING_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
BUILDING_SEGMENTER_MODEL=facebook/sam-vit-base
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Directory where uploaded/sample datasets live
DATA_DIR=../data
# Optional explicit snapshot file path; defaults to $DATA_DIR/generated/previous_snapshot.json.
CHANGE_SNAPSHOT_PATH=

# CORS origin for frontend dev server
FRONTEND_ORIGIN=http://localhost:5173

# Default target CRS for harmonized output
TARGET_CRS=EPSG:4326

# Spatial matching max distance (meters) to consider two features candidate matches
MATCH_MAX_DISTANCE_M=75

# Ward-scale direct upload limit. Use COG/object storage + a job queue for
# city-scale raster assets in production.
MAX_UPLOAD_SIZE_MB=50

# Redis-backed login limits: failed attempts per email/IP pair, per-IP ceiling, and window.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Log level
LOG_LEVEL=INFO
